# ── Setup ────────────────────────────────────────────────────────────────────
# Copy this file: cp .env.example .env
# Then fill in your own values. NEVER commit .env to git.
#
# Each team member needs their own .env with their own wallet keys.
# Contract addresses (NEXT_PUBLIC_*) are shared — fill them after deploy.

# ── Backend (Polina) ─────────────────────────────────────────────────────────
# When set, /api/state proxies to {BACKEND_URL}/state instead of running indexer locally
BACKEND_URL=

# ── RPC ─────────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Wallets (testnet only — get Base Sepolia ETH from faucet) ────────────────
# Generate your own wallets: cast wallet new
# Fund them at: https://www.coinbase.com/faucets/base-ethereum-goerli-faucet
DEPLOYER_PK=0x...
AGENT_PK=0x...
FLAGGER_PK=0x...

# ── Basescan (for forge --verify) ───────────────────────────────────────────
# Get API key at: https://basescan.org/myapikey
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ── Contract addresses (fill AFTER deploy, same for all team members) ────────
NEXT_PUBLIC_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_VAULT_ADDRESS=0x...
NEXT_PUBLIC_VERIFIER_ADDRESS=0x...

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ── Indexer ──────────────────────────────────────────────────────────────────
# Block number at deploy time (copy from Basescan tx after deploy)
DEPLOY_BLOCK=0
